.env

# Private local notes / decisions — never tracked
.me/

# Python bytecode
__pycache__/
*.py[cod]
*.pyc.*

# Firecrawl local cache
.firecrawl/

# Pipeline outputs (user-generated, not part of the tool)
projects/

# Downloaded external data
data/external/

# User data files (CSV, DTA, Parquet, etc.)
data/*.csv
data/*.dta
data/*.parquet
data/*.xlsx
data/*.json

# OS junk
Thumbs.db
.DS_Store
