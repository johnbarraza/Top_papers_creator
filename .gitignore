.env

# Private local notes / decisions — never tracked
.me/

# Python bytecode
__pycache__/
*.py[cod]
*.pyc.*

# Firecrawl local cache
.firecrawl/

# Pipeline outputs — exclude all project runs except mining base
# (mining_canon pipeline_state.json gives Path A/C dedup a reference point on fresh clones)
projects/*
!projects/mining_canon_and_local_development_in_peru_20260530_121243
projects/mining_canon_and_local_development_in_peru_20260530_121243/data/
projects/mining_canon_and_local_development_in_peru_20260530_121243/quality_reports/
projects/mining_canon_and_local_development_in_peru_20260530_121243/paper/figures/

# Downloaded external data
data/external/

# User data files (CSV, DTA, Parquet, etc.)
data/*.csv
data/*.dta
data/*.parquet
data/*.xlsx
data/*.json

# OS junk
Thumbs.db
.DS_Store
